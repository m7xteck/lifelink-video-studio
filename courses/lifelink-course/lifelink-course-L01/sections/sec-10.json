{"section": {"id": "sec-10", "title": "Amanah: A Sacred Trust", "startSec": 1086.4, "endSec": 1228.5},
"scenes": [
{"id": "sec-10-01", "sectionId": "sec-10", "type": "kineticStatement", "startSec": 1086.4, "endSec": 1095.9, "props": {"kicker": {"text": "A particularly important concept", "at": 1088.94}, "lines": [{"text": "Amanah", "at": 1091.42}, {"text": "trust, or responsibility.", "at": 1093.48}], "emphasis": ["Amanah"], "align": "center", "scale": "h1", "reveal": "ink"}},
{"id": "sec-10-02", "sectionId": "sec-10", "type": "wordStack", "startSec": 1095.9, "endSec": 1103.9, "props": {"variant": "offset", "lead": {"text": "In marriage, this means recognising that our spouse is someone whose", "at": 1096.1}, "words": [{"text": "Dignity", "at": 1100.04}, {"text": "Wellbeing", "at": 1100.84}, {"text": "Rights", "at": 1101.68}]}},
{"id": "sec-10-03", "sectionId": "sec-10", "type": "quietReflection", "startSec": 1103.9, "endSec": 1111.2, "props": {"text": "Live with our spouses in kindness.", "at": 1105.6, "attribution": "Surah An-Nisa 4:19"}},
{"id": "sec-10-04", "sectionId": "sec-10", "type": "highlightLine", "startSec": 1111.2, "endSec": 1117.9, "props": {"lines": [{"text": "This principle should influence", "at": 1111.46}, {"text": "how we speak, behave and make decisions", "at": 1113.6}, {"text": "within marriage.", "at": 1116.3}], "highlight": {"text": "speak, behave and make decisions", "at": 1114.12}, "tint": "sky"}},
{"id": "sec-10-05", "sectionId": "sec-10", "type": "balanceScale", "startSec": 1117.9, "endSec": 1142.9, "props": {"beamAt": 1118.38, "left": {"label": "Responsibility", "at": 1123.62, "items": [{"text": "Feelings", "at": 1128.46}, {"text": "Boundaries", "at": 1129.36}, {"text": "Dignity", "at": 1130.06}, {"text": "Compassion", "at": 1133.9}]}, "right": {"label": "Control", "at": 1141.36, "items": []}}},
{"id": "sec-10-06", "sectionId": "sec-10", "type": "pullQuote", "startSec": 1142.9, "endSec": 1152.7, "props": {"lines": [{"text": "Marriage is not ownership.", "at": 1143.06}, {"text": "Neither spouse has the right to use marriage", "at": 1145.16}, {"text": "as an excuse for humiliation,", "at": 1147.72}, {"text": "threats, violence or coercion.", "at": 1149.7}], "emphasis": ["ownership"]}},
{"id": "sec-10-07", "sectionId": "sec-10", "type": "kineticStatement", "startSec": 1152.7, "endSec": 1163.3, "props": {"lines": [{"text": "Preventing a spouse from maintaining", "at": 1153.58}, {"text": "relationships with family and friends", "at": 1155.86}, {"text": "as a means of isolating them", "at": 1157.76}, {"text": "is not a healthy expression of care.", "at": 1159.82}], "emphasis": ["isolating", "not"], "align": "left", "scale": "h2", "reveal": "focus"}},
{"id": "sec-10-08", "sectionId": "sec-10", "type": "balanceScale", "startSec": 1163.3, "endSec": 1188.5, "props": {"beamAt": 1117.0, "left": {"label": "Responsibility", "at": 1123.62, "items": [{"text": "Feelings", "at": 1128.46}, {"text": "Boundaries", "at": 1129.36}, {"text": "Dignity", "at": 1130.06}, {"text": "Compassion", "at": 1133.9}]}, "right": {"label": "Control", "at": 1141.36, "items": [{"text": "Isolating", "at": 1158.82}, {"text": "Monitoring", "at": 1164.3}, {"text": "Money to control", "at": 1166.7}, {"text": "Threats", "at": 1168.98}, {"text": "Coercion", "at": 1172.2}]}, "release": {"side": "right", "at": 1184.54}}},
{"id": "sec-10-09", "sectionId": "sec-10", "type": "wordStack", "startSec": 1188.5, "endSec": 1196.9, "props": {"variant": "column", "lead": {"text": "Let us also consider commitment. Marriage requires", "at": 1188.85}, "words": [{"text": "Patience", "at": 1192.16}, {"text": "Effort", "at": 1193.3}, {"text": "Willingness", "at": 1194.12}]}},
{"id": "sec-10-10", "sectionId": "sec-10", "type": "highlightLine", "startSec": 1196.9, "endSec": 1203.6, "props": {"lines": [{"text": "However, commitment never means", "at": 1197.22}, {"text": "that someone must tolerate abuse", "at": 1198.78}, {"text": "or remain in danger.", "at": 1200.68}], "highlight": {"text": "never means", "at": 1198.0}, "tint": "royal"}},
{"id": "sec-10-11", "sectionId": "sec-10", "type": "kineticStatement", "startSec": 1203.6, "endSec": 1209.2, "props": {"lines": [{"text": "A healthy relationship should protect", "at": 1203.86}, {"text": "the dignity and safety of both individuals.", "at": 1205.82}], "emphasis": ["dignity", "safety"], "align": "center", "scale": "h2", "reveal": "ink"}},
{"id": "sec-10-12", "sectionId": "sec-10", "type": "balanceScale", "startSec": 1209.2, "endSec": 1220.2, "props": {"beamAt": 1117.0, "left": {"label": "Responsibility", "at": 1123.62, "items": [{"text": "Feelings", "at": 1128.46}, {"text": "Boundaries", "at": 1129.36}, {"text": "Dignity", "at": 1130.06}, {"text": "Compassion", "at": 1133.9}]}, "right": {"label": "Trust", "at": 1212.12, "items": [{"text": "Consistent behaviour", "at": 1213.32}, {"text": "Respected", "at": 1216.6}, {"text": "Listened to", "at": 1217.66}, {"text": "Emotionally safe", "at": 1218.5}]}}},
{"id": "sec-10-13", "sectionId": "sec-10", "type": "chapterRecap", "startSec": 1220.2, "endSec": 1228.5, "props": {"title": {"text": "Amanah", "at": 1220.4}, "signature": {"type": "balanceScale", "props": {"beamAt": 0, "left": {"label": "Responsibility", "at": 0, "items": [{"text": "Feelings", "at": 0}, {"text": "Boundaries", "at": 0}, {"text": "Dignity", "at": 0}, {"text": "Compassion", "at": 0}]}, "right": {"label": "Trust", "at": 0, "items": [{"text": "Consistent behaviour", "at": 0}, {"text": "Respected", "at": 0}, {"text": "Listened to", "at": 0}, {"text": "Emotionally safe", "at": 0}]}, "pivot": {"text": "amanah", "at": 0}}}, "cardAt": 1220.4, "words": [{"text": "Protecting the trust", "at": 1221.48}, {"text": "Not power over another", "at": 1224.1}]}}
]}
