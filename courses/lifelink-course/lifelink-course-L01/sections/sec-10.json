{"section": {"id": "sec-10", "title": "Amanah: A Sacred Trust", "startSec": 1086.4, "endSec": 1228.5},
"scenes": [
{"type": "kineticStatement", "id": "sec-10-01", "sectionId": "sec-10", "startSec": 1086.4, "endSec": 1095.6, "props": {"kicker": {"text": "A particularly important concept", "at": 1087.76}, "lines": [{"text": "Amanah", "at": 1091.42}, {"text": "trust, or responsibility.", "at": 1093.48}], "emphasis": ["Amanah"], "align": "center", "scale": "h1"}},
{"type": "parallelPhrases", "id": "sec-10-02", "sectionId": "sec-10", "startSec": 1095.6, "endSec": 1103.6, "props": {"kicker": {"text": "In marriage, our spouse's", "at": 1096.08}, "items": [{"text": "Dignity", "at": 1100.04}, {"text": "Wellbeing", "at": 1100.84}, {"text": "Rights", "at": 1101.68}], "closing": {"text": "must be respected.", "at": 1102.08}}},
{"type": "quietReflection", "id": "sec-10-03", "sectionId": "sec-10", "startSec": 1103.6, "endSec": 1110.9, "props": {"text": "Live with our spouses in kindness.", "at": 1105.94, "attribution": "Surah An-Nisa 4:19"}},
{"type": "parallelPhrases", "id": "sec-10-04", "sectionId": "sec-10", "startSec": 1110.9, "endSec": 1117.9, "props": {"kicker": {"text": "This principle should influence how we", "at": 1111.46}, "items": [{"text": "Speak", "at": 1114.12}, {"text": "Behave", "at": 1114.9}, {"text": "Make decisions", "at": 1115.7}]}},
{"type": "statementCollision", "id": "sec-10-05", "sectionId": "sec-10", "startSec": 1117.9, "endSec": 1126.2, "props": {"label": "A healthy understanding of Amanah", "first": {"text": "Both spouses have", "at": 1121.88}, "script": {"text": "responsibilities", "at": 1123.62}, "second": {"text": "towards one another.", "at": 1124.24}}},
{"type": "kineticStatement", "id": "sec-10-06", "sectionId": "sec-10", "startSec": 1126.2, "endSec": 1136.6, "props": {"lines": [{"text": "Respecting each other's feelings, boundaries and dignity.", "at": 1127.04}, {"text": "Approaching disagreements with compassion,", "at": 1132.06}, {"text": "rather than intimidation.", "at": 1134.4}], "emphasis": ["compassion"], "align": "left", "scale": "h2"}},
{"type": "kineticStatement", "id": "sec-10-07", "sectionId": "sec-10", "startSec": 1136.6, "endSec": 1142.9, "props": {"kicker": {"text": "However, it is important to distinguish between", "at": 1136.78}, "lines": [{"text": "responsibility", "at": 1139.86}, {"text": "and control.", "at": 1140.58}], "emphasis": [], "align": "center", "scale": "h1"}},
{"type": "kineticStatement", "id": "sec-10-08", "sectionId": "sec-10", "startSec": 1142.9, "endSec": 1152.6, "props": {"lines": [{"text": "Marriage is not ownership.", "at": 1143.06}, {"text": "Neither spouse has the right to use marriage as an excuse", "at": 1145.16}, {"text": "for humiliation, threats, violence or coercion.", "at": 1148.2}], "emphasis": ["not"], "align": "center", "scale": "h2"}},
{"type": "kineticStatement", "id": "sec-10-09", "sectionId": "sec-10", "startSec": 1152.6, "endSec": 1163.2, "props": {"kicker": {"text": "For example", "at": 1152.9}, "lines": [{"text": "Isolating a spouse from family and friends", "at": 1153.58}, {"text": "is not a healthy expression of care.", "at": 1160.06}], "emphasis": ["not"], "align": "center", "scale": "h1"}},
{"type": "parallelPhrases", "id": "sec-10-10", "sectionId": "sec-10", "startSec": 1163.2, "endSec": 1174.4, "props": {"kicker": {"text": "Similarly", "at": 1163.52}, "items": [{"text": "Monitoring every movement", "at": 1164.3}, {"text": "Using money to control behaviour", "at": 1166.7}, {"text": "Threatening to obtain compliance", "at": 1168.98}], "closing": {"text": "can be signs of coercive control.", "at": 1171.08}}},
{"type": "kineticStatement", "id": "sec-10-11", "sectionId": "sec-10", "startSec": 1174.4, "endSec": 1182.5, "props": {"lines": [{"text": "Harmful behaviours are sometimes wrongfully justified", "at": 1175.04}, {"text": "through cultural expectations or selective religious arguments.", "at": 1178.34}], "emphasis": [], "align": "left", "scale": "h2"}},
{"type": "kineticStatement", "id": "sec-10-12", "sectionId": "sec-10", "startSec": 1182.5, "endSec": 1188.3, "props": {"kicker": {"text": "We must be very clear", "at": 1182.8}, "lines": [{"text": "Abuse is not", "at": 1184.54}, {"text": "a demonstration of Islamic responsibility.", "at": 1185.4}], "emphasis": ["not"], "align": "center", "scale": "h1"}},
{"type": "parallelPhrases", "id": "sec-10-13", "sectionId": "sec-10", "startSec": 1188.3, "endSec": 1196.9, "props": {"kicker": {"text": "Marriage requires", "at": 1191.6}, "items": [{"text": "Patience", "at": 1192.16}, {"text": "Effort", "at": 1193.3}, {"text": "Willingness to work through difficulties", "at": 1194.12}]}},
{"type": "kineticStatement", "id": "sec-10-14", "sectionId": "sec-10", "startSec": 1196.9, "endSec": 1203.5, "props": {"kicker": {"text": "However", "at": 1197.22}, "lines": [{"text": "Commitment never means", "at": 1197.86}, {"text": "tolerating abuse", "at": 1199.8}, {"text": "or remaining in danger.", "at": 1200.68}], "emphasis": ["never"], "align": "center", "scale": "h1"}},
{"type": "kineticStatement", "id": "sec-10-15", "sectionId": "sec-10", "startSec": 1203.5, "endSec": 1209.2, "props": {"kicker": {"text": "A healthy relationship", "at": 1203.8}, "lines": [{"text": "should protect dignity and safety", "at": 1205.34}, {"text": "for both.", "at": 1207.54}], "emphasis": ["dignity", "safety"], "align": "center", "scale": "h1"}},
{"type": "kineticStatement", "id": "sec-10-16a", "sectionId": "sec-10", "startSec": 1209.2, "endSec": 1214.9, "props": {"kicker": {"text": "As you prepare for marriage", "at": 1209.42}, "lines": [{"text": "Trust is built through consistent behaviour.", "at": 1212.12}], "emphasis": ["consistent"], "align": "center", "scale": "h2"}},
{"type": "parallelPhrases", "id": "sec-10-16b", "sectionId": "sec-10", "startSec": 1214.9, "endSec": 1220.2, "props": {"kicker": {"text": "It develops when people feel", "at": 1215.16}, "items": [{"text": "Respected", "at": 1216.6}, {"text": "Listened to", "at": 1217.66}, {"text": "Emotionally safe", "at": 1218.5}]}},
{"type": "kineticStatement", "id": "sec-10-17", "sectionId": "sec-10", "startSec": 1220.2, "endSec": 1228.5, "props": {"kicker": {"text": "Amanah", "at": 1220.4}, "lines": [{"text": "Protecting the trust placed in us,", "at": 1221.48}, {"text": "not using that trust as power over another.", "at": 1224.1}], "emphasis": ["Protecting"], "align": "center", "scale": "h1"}}
]}
