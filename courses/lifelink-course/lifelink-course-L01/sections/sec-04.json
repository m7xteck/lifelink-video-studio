{"section":{"id": "sec-04", "title": "Three Pillars: Sakina, Mawaddah, Rahmah", "startSec": 264, "endSec": 406},
"scenes":[
{"type": "kineticStatement", "id": "sec-04-01", "sectionId": "sec-04", "startSec": 264.0, "endSec": 272.6, "props": {"kicker": {"text": "Surah Ar-Rum · 30:21", "at": 269.4}, "lines": [{"text": "A beautiful description of marriage in the Quran", "at": 265.04}], "emphasis": ["marriage"], "align": "center", "scale": "h2"}},
{"type": "kineticStatement", "id": "sec-04-02", "sectionId": "sec-04", "startSec": 272.6, "endSec": 284.4, "props": {"kicker": {"text": "Allah tells us", "at": 272.74}, "lines": [{"text": "Amongst His signs:", "at": 274.36}, {"text": "He created spouses so that we may find tranquility in them", "at": 276.14}, {"text": "and places affection and mercy between them", "at": 279.72}], "emphasis": ["tranquility", "affection", "mercy"], "align": "center", "scale": "h2"}},
{"type": "kineticStatement", "id": "sec-04-03", "sectionId": "sec-04", "startSec": 284.4, "endSec": 296.4, "props": {"kicker": {"text": "Three essential pillars of marriage", "at": 285.26}, "lines": [{"text": "Sakinah", "at": 289.74}, {"text": "Tranquility", "at": 291.44}], "emphasis": ["Sakinah"], "align": "left", "scale": "h1"}},
{"type": "parallelPhrases", "id": "sec-04-04", "sectionId": "sec-04", "startSec": 296.4, "endSec": 309.0, "props": {"kicker": {"text": "Tranquility means", "at": 296.72}, "items": [{"text": "Feeling emotionally secure", "at": 296.98}, {"text": "Knowing you can express your thoughts without fear or humiliation", "at": 299.22}, {"text": "Trusting your spouse will treat you with dignity and respect", "at": 304.54}]}},
{"type": "comparison", "id": "sec-04-05", "sectionId": "sec-04", "startSec": 309.0, "endSec": 321.2, "props": {"left": {"title": "A peaceful marriage does not mean", "points": ["Disagreements never happen"], "at": 309.24}, "right": {"title": "It means", "points": ["Both are committed to resolving difficulties without causing unnecessary harm"], "at": 312.78}, "preferred": "right"}},
{"type": "kineticStatement", "id": "sec-04-06", "sectionId": "sec-04", "startSec": 321.2, "endSec": 332.8, "props": {"kicker": {"text": "The second pillar", "at": 322.08}, "lines": [{"text": "Mawaddah", "at": 323.28}, {"text": "Affection", "at": 324.42}, {"text": "Demonstrated through everyday actions", "at": 329.66}], "emphasis": ["Mawaddah"], "align": "left", "scale": "h1"}},
{"type": "parallelPhrases", "id": "sec-04-07", "sectionId": "sec-04", "startSec": 332.8, "endSec": 347.0, "props": {"items": [{"text": "A kind word", "at": 333.06}, {"text": "A thoughtful gesture", "at": 334.26}, {"text": "Showing appreciation", "at": 335.62}, {"text": "Meaningful time and support", "at": 337.52}], "closing": {"lead": "These small acts", "leadAt": 343.36, "text": "strengthen emotional connection", "at": 344.44}}},
{"type": "kineticStatement", "id": "sec-04-08", "sectionId": "sec-04", "startSec": 347.0, "endSec": 356.2, "props": {"kicker": {"text": "The third pillar", "at": 348.38}, "lines": [{"text": "Rahmah", "at": 349.68}, {"text": "Mercy", "at": 350.86}, {"text": "Particularly important when life is challenging", "at": 352.54}], "emphasis": ["Rahmah"], "align": "left", "scale": "h1"}},
{"type": "kineticStatement", "id": "sec-04-09", "sectionId": "sec-04", "startSec": 356.2, "endSec": 367.6, "props": {"kicker": {"text": "Mercy", "at": 356.66}, "lines": [{"text": "When one spouse is tired, unwell, worried or struggling", "at": 357.52}, {"text": "compassion and understanding", "at": 363.54}, {"text": "can make an enormous difference", "at": 365.12}], "emphasis": ["compassion", "understanding"], "align": "left", "scale": "h1"}},
{"type": "quietReflection", "id": "sec-04-10", "sectionId": "sec-04", "startSec": 367.6, "endSec": 376.6, "props": {"text": "Our spouse is human, with strengths, weaknesses, emotions and vulnerabilities.", "at": 370.26}},
{"type": "stepsDiagram", "id": "sec-04-11", "sectionId": "sec-04", "startSec": 376.6, "endSec": 391.0, "props": {"heading": "Three qualities, together", "steps": [{"label": "Sakinah", "detail": "Tranquility · provides emotional security", "at": 380.86}, {"label": "Mawaddah", "detail": "Affection · builds connection", "at": 384.32}, {"label": "Rahmah", "detail": "Mercy · sustains through difficulty", "at": 387.36}], "layout": "stack"}},
{"type": "reflectionField", "id": "sec-04-12", "sectionId": "sec-04", "startSec": 391.0, "endSec": 406.0, "props": {"script": {"text": "reflect for a moment", "at": 391.6}, "lines": [{"text": "When you think about your future marriage,", "at": 393.72}, {"text": "which of these three qualities", "at": 396.58}, {"text": "do you believe you already demonstrate well?", "at": 398.42}], "after": [{"text": "And which would you like to develop further?", "at": 402.22}], "ground": "oxblood"}}
]}
