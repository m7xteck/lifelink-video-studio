      "startSec": 643.6,
      "endSec": 655.2,
      "props": {
        "lines": [
          {
            "text": "How do I respond when I am frustrated?",
            "at": 644.22
          },
          {
            "text": "Do I apologise when I am wrong?",
            "at": 647.66
          },
          {
            "text": "Can I acknowledge another person's feelings",
