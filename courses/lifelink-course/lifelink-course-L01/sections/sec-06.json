      "props": {
        "lines": [
          {
            "text": "As you prepare for marriage, ask yourself:",
            "at": 633.34
          },
          {
            "text": "Am I as respectful towards those closest to me",
            "at": 637.62
          },
          {
            "text": "as I am towards people outside my home?",
            "at": 641.04
          }
        ],
        "markAt": 636.3,
