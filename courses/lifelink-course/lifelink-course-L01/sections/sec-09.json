{"section": {"id": "sec-09", "title": "Partnership, Not Competition", "startSec": 946.8, "endSec": 1086.4},
"scenes": [
{"id": "sec-09-01", "sectionId": "sec-09", "type": "parallelPhrases", "startSec": 946.8, "endSec": 955.65, "props": {"kicker": {"text": "Two individuals who may have very different", "at": 949.32}, "items": [{"text": "Personalities", "at": 951.86}, {"text": "Experiences", "at": 953.0}, {"text": "Perspectives", "at": 954.12}]}},
{"id": "sec-09-02", "sectionId": "sec-09", "type": "statementCollision", "startSec": 955.65, "endSec": 961.3, "props": {"label": "Even when two people share the same religious values", "first": {"text": "they will", "at": 958.6}, "script": {"text": "not necessarily", "at": 958.96}, "second": {"text": "think alike.", "at": 959.78}}},
{"id": "sec-09-03", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 961.3, "endSec": 970.9, "props": {"lines": [{"text": "One person may be naturally outgoing,", "at": 961.35}, {"text": "whilst the other is more reserved.", "at": 964.5}, {"text": "One may prefer careful planning,", "at": 966.68}, {"text": "whilst the other is more spontaneous.", "at": 968.66}], "emphasis": ["outgoing", "reserved", "planning", "spontaneous"], "align": "left", "scale": "h2"}},
{"id": "sec-09-04", "sectionId": "sec-09", "type": "comparison", "startSec": 970.9, "endSec": 976.9, "props": {"left": {"title": "Words", "points": ["Expressing affection"], "at": 972.84}, "right": {"title": "Practical actions", "points": ["Demonstrating care"], "at": 975.16}, "preferred": "none"}},
{"id": "sec-09-05", "sectionId": "sec-09", "type": "statementCollision", "startSec": 976.9, "endSec": 982.2, "props": {"first": {"text": "These differences", "at": 977.3}, "script": {"text": "do not automatically mean", "at": 978.16}, "second": {"text": "two people are incompatible.", "at": 979.64}}},
{"id": "sec-09-06", "sectionId": "sec-09", "type": "parallelPhrases", "startSec": 982.2, "endSec": 987.9, "props": {"kicker": {"text": "What matters is how they", "at": 982.5}, "items": [{"text": "Understand", "at": 984.02}, {"text": "Respect", "at": 984.96}, {"text": "Respond", "at": 985.6}]}},
{"id": "sec-09-07", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 987.9, "endSec": 993.0, "props": {"lines": [{"text": "A healthy marriage is built on", "at": 988.16}, {"text": "partnership", "at": 990.7}, {"text": "rather than competition.", "at": 991.28}], "emphasis": ["partnership"], "align": "center", "scale": "h1"}},
{"id": "sec-09-08", "sectionId": "sec-09", "type": "stepsDiagram", "startSec": 993.0, "endSec": 999.8, "props": {"heading": "Four elements of partnership", "steps": [{"label": "Respectful consultation", "at": 997.74}, {"label": "Shared responsibilities", "at": 1007.88}, {"label": "Mutual support", "at": 1026.92}, {"label": "Honouring individuality", "at": 1049.98}], "layout": "path"}},
{"id": "sec-09-09", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 999.8, "endSec": 1006.4, "props": {"kicker": {"text": "Respectful consultation", "at": 999.9}, "lines": [{"text": "Important decisions", "at": 1000.1}, {"text": "should involve meaningful discussion,", "at": 1001.14}, {"text": "particularly when these decisions", "at": 1003.24}, {"text": "affect both spouses.", "at": 1004.86}], "emphasis": ["meaningful", "discussion", "both"], "align": "left", "scale": "h2"}},
{"id": "sec-09-10", "sectionId": "sec-09", "type": "stepsDiagram", "startSec": 1006.4, "endSec": 1010.4, "props": {"heading": "Four elements of partnership", "steps": [{"label": "Respectful consultation", "at": 1006.4}, {"label": "Shared responsibilities", "at": 1007.88}, {"label": "Mutual support", "at": 1026.92}, {"label": "Honouring individuality", "at": 1049.98}], "layout": "path"}},
{"id": "sec-09-11", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 1010.4, "endSec": 1016.1, "props": {"kicker": {"text": "Shared responsibilities", "at": 1010.4}, "lines": [{"text": "Marriage involves practical commitments", "at": 1010.4}, {"text": "and couples need to understand", "at": 1012.02}, {"text": "how these responsibilities will be managed.", "at": 1013.82}], "emphasis": ["practical", "understand"], "align": "left", "scale": "h2"}},
{"id": "sec-09-12", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 1016.1, "endSec": 1025.9, "props": {"lines": [{"text": "This does not necessarily mean", "at": 1016.16}, {"text": "dividing every task equally,", "at": 1018.36}, {"text": "it means developing arrangements that are", "at": 1020.8}, {"text": "fair, understood and agreed upon.", "at": 1022.82}], "emphasis": ["fair", "understood", "agreed"], "align": "left", "scale": "h2"}},
{"id": "sec-09-13", "sectionId": "sec-09", "type": "stepsDiagram", "startSec": 1025.9, "endSec": 1029.9, "props": {"heading": "Four elements of partnership", "steps": [{"label": "Respectful consultation", "at": 1025.9}, {"label": "Shared responsibilities", "at": 1025.95}, {"label": "Mutual support", "at": 1026.92}, {"label": "Honouring individuality", "at": 1049.98}], "layout": "path"}},
{"id": "sec-09-14", "sectionId": "sec-09", "type": "parallelPhrases", "startSec": 1029.9, "endSec": 1035.75, "props": {"kicker": {"text": "Supporting one another's", "at": 1030.34}, "items": [{"text": "Personal", "at": 1031.8}, {"text": "Professional", "at": 1032.56}, {"text": "Spiritual", "at": 1033.68}], "closing": {"text": "development", "at": 1034.18}}},
{"id": "sec-09-15", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 1035.75, "endSec": 1047.6, "props": {"kicker": {"text": "For example", "at": 1035.84}, "lines": [{"text": "If one spouse wishes", "at": 1036.56}, {"text": "to continue their education,", "at": 1037.68}, {"text": "a supportive partner will consider", "at": 1039.8}, {"text": "how that ambition can be accommodated", "at": 1041.64}, {"text": "alongside their shared responsibilities.", "at": 1044.4}], "emphasis": ["supportive", "accommodated"], "align": "left", "scale": "h2"}},
{"id": "sec-09-16", "sectionId": "sec-09", "type": "stepsDiagram", "startSec": 1047.6, "endSec": 1051.9, "props": {"heading": "Four elements of partnership", "steps": [{"label": "Respectful consultation", "at": 1047.6}, {"label": "Shared responsibilities", "at": 1047.65}, {"label": "Mutual support", "at": 1047.7}, {"label": "Honouring individuality", "at": 1049.98}], "layout": "path"}},
{"id": "sec-09-17", "sectionId": "sec-09", "type": "statementCollision", "startSec": 1051.9, "endSec": 1055.9, "props": {"label": "Honouring individuality", "first": {"text": "Being married", "at": 1052.46}, "script": {"text": "does not mean", "at": 1052.98}, "second": {"text": "losing your identity.", "at": 1053.78}}},
{"id": "sec-09-18", "sectionId": "sec-09", "type": "parallelPhrases", "startSec": 1055.9, "endSec": 1064.4, "props": {"kicker": {"text": "Both spouses remain individuals with their own", "at": 1056.18}, "items": [{"text": "Personalities", "at": 1058.82}, {"text": "Interests", "at": 1060.9}, {"text": "Strengths", "at": 1062.02}, {"text": "Aspirations", "at": 1062.54}]}},
{"id": "sec-09-19", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 1064.4, "endSec": 1071.8, "props": {"lines": [{"text": "Marriage should provide", "at": 1064.66}, {"text": "opportunities for growth", "at": 1065.42}, {"text": "rather than requiring one person", "at": 1066.9}, {"text": "to disappear", "at": 1068.58}, {"text": "into their expectations of another.", "at": 1069.44}], "emphasis": ["growth"], "align": "center", "scale": "h2"}},
{"id": "sec-09-20", "sectionId": "sec-09", "type": "comparison", "startSec": 1071.8, "endSec": 1080.2, "props": {"left": {"title": "Not asking", "points": ["Who has more power?"], "at": 1074.38}, "right": {"title": "But asking", "points": ["How can we work together?"], "at": 1078.22}, "preferred": "right"}},
{"id": "sec-09-21", "sectionId": "sec-09", "type": "parallelPhrases", "startSec": 1080.2, "endSec": 1086.4, "props": {"kicker": {"text": "A relationship in which both of us are", "at": 1080.42}, "items": [{"text": "Respected", "at": 1082.98}, {"text": "Supported", "at": 1083.98}, {"text": "Valued", "at": 1084.9}]}}
]}
