{"section": {"id": "sec-09", "title": "Partnership, Not Competition", "startSec": 946.8, "endSec": 1086.4},
"scenes": [
{"id": "sec-09-01", "sectionId": "sec-09", "type": "wordStack", "startSec": 946.8, "endSec": 955.65, "props": {"lead": {"text": "This brings together two individuals who may have very different", "at": 948.3}, "words": [{"text": "Personalities", "at": 951.86}, {"text": "Experiences", "at": 953.0}, {"text": "Perspectives", "at": 954.12}]}},
{"id": "sec-09-02", "sectionId": "sec-09", "type": "highlightLine", "startSec": 955.65, "endSec": 961.1, "props": {"lines": [{"text": "Even when two people share the same religious values,", "at": 955.68}, {"text": "they will not necessarily think alike.", "at": 958.6}], "highlight": {"text": "think alike", "at": 959.78}, "tint": "sky"}},
{"id": "sec-09-03", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 961.1, "endSec": 970.9, "props": {"lines": [{"text": "One person may be naturally outgoing,", "at": 961.2}, {"text": "whilst the other is more reserved.", "at": 964.5}, {"text": "One may prefer careful planning,", "at": 966.68}, {"text": "whilst the other is more spontaneous.", "at": 968.66}], "emphasis": ["outgoing", "reserved", "planning", "spontaneous"], "align": "left", "scale": "h2", "reveal": "rise"}},
{"id": "sec-09-04", "sectionId": "sec-09", "type": "comparison", "startSec": 970.9, "endSec": 976.9, "props": {"left": {"title": "Words", "points": ["Expressing affection"], "at": 972.84}, "right": {"title": "Practical actions", "points": ["Demonstrating care"], "at": 975.16}, "preferred": "none"}},
{"id": "sec-09-05", "sectionId": "sec-09", "type": "statementCollision", "startSec": 976.9, "endSec": 982.2, "props": {"first": {"text": "These differences", "at": 977.3}, "script": {"text": "do not automatically mean", "at": 978.16}, "second": {"text": "two people are incompatible.", "at": 979.64}}},
{"id": "sec-09-06", "sectionId": "sec-09", "type": "wordStack", "startSec": 982.2, "endSec": 987.9, "props": {"lead": {"text": "What matters is how they", "at": 982.5}, "words": [{"text": "Understand", "at": 984.02}, {"text": "Respect", "at": 984.96}, {"text": "Respond", "at": 985.6}]}},
{"id": "sec-09-07", "sectionId": "sec-09", "type": "pullQuote", "startSec": 987.9, "endSec": 993.0, "props": {"lines": [{"text": "A healthy marriage is built on partnership", "at": 988.16}, {"text": "rather than competition.", "at": 991.28}], "emphasis": ["partnership"]}},
{"id": "sec-09-08", "sectionId": "sec-09", "type": "bridgePlanks", "startSec": 993.0, "endSec": 1010.2, "props": {"cliffsAt": 994.24, "planks": [{"text": "Respectful consultation", "at": 997.74}, {"text": "Shared responsibilities", "at": 1007.88}, {"text": "Mutual support", "at": 1026.92}, {"text": "Honouring individuality", "at": 1049.98}], "caption": {"text": "meaningful discussion", "at": 1001.84}, "focus": [{"index": 0, "at": 1000.1}, {"index": 1, "at": 1007.88}]}},
{"id": "sec-09-09", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 1010.2, "endSec": 1016.0, "props": {"lines": [{"text": "Marriage involves practical commitments", "at": 1010.32}, {"text": "and couples need to understand", "at": 1012.02}, {"text": "how these responsibilities will be managed.", "at": 1013.82}], "emphasis": ["practical", "understand"], "align": "left", "scale": "h2", "reveal": "ink"}},
{"id": "sec-09-10", "sectionId": "sec-09", "type": "highlightLine", "startSec": 1016.0, "endSec": 1025.9, "props": {"lines": [{"text": "This does not necessarily mean dividing every task equally,", "at": 1016.16}, {"text": "it means developing arrangements that are", "at": 1020.8}, {"text": "fair, understood and agreed upon.", "at": 1022.82}], "highlight": {"text": "fair, understood and agreed upon", "at": 1022.82}, "tint": "royal"}},
{"id": "sec-09-11", "sectionId": "sec-09", "type": "bridgePlanks", "startSec": 1025.9, "endSec": 1035.75, "props": {"cliffsAt": 1025.9, "planks": [{"text": "Respectful consultation", "at": 997.74}, {"text": "Shared responsibilities", "at": 1007.88}, {"text": "Mutual support", "at": 1026.92}, {"text": "Honouring individuality", "at": 1049.98}], "caption": {"text": "supporting one another", "at": 1030.34}, "focus": [{"index": 1, "at": 1025.9}, {"index": 2, "at": 1026.92}]}},
{"id": "sec-09-12", "sectionId": "sec-09", "type": "kineticStatement", "startSec": 1035.75, "endSec": 1048.0, "props": {"lines": [{"text": "For example, if one spouse wishes", "at": 1035.84}, {"text": "to continue their education,", "at": 1037.68}, {"text": "a supportive partner will consider", "at": 1039.8}, {"text": "how that ambition can be accommodated", "at": 1041.64}, {"text": "alongside their shared responsibilities.", "at": 1044.4}], "emphasis": ["supportive", "accommodated"], "align": "left", "scale": "h2", "reveal": "focus"}},
{"id": "sec-09-13", "sectionId": "sec-09", "type": "bridgePlanks", "startSec": 1048.0, "endSec": 1052.3, "props": {"cliffsAt": 1048.0, "planks": [{"text": "Respectful consultation", "at": 997.74}, {"text": "Shared responsibilities", "at": 1007.88}, {"text": "Mutual support", "at": 1026.92}, {"text": "Honouring individuality", "at": 1049.98}], "focus": [{"index": 2, "at": 1048.0}, {"index": 3, "at": 1049.98}]}},
{"id": "sec-09-14", "sectionId": "sec-09", "type": "statementCollision", "startSec": 1052.3, "endSec": 1055.9, "props": {"first": {"text": "Being married", "at": 1052.46}, "script": {"text": "does not mean", "at": 1052.98}, "second": {"text": "losing your identity.", "at": 1053.78}}},
{"id": "sec-09-15", "sectionId": "sec-09", "type": "wordStack", "startSec": 1055.9, "endSec": 1064.4, "props": {"lead": {"text": "Both spouses remain individuals with their own", "at": 1056.18}, "words": [{"text": "Personalities", "at": 1058.82}, {"text": "Interests", "at": 1060.9}, {"text": "Strengths", "at": 1062.02}, {"text": "Aspirations", "at": 1062.54}]}},
{"id": "sec-09-16", "sectionId": "sec-09", "type": "highlightLine", "startSec": 1064.4, "endSec": 1071.9, "props": {"lines": [{"text": "Marriage should provide opportunities for growth", "at": 1064.66}, {"text": "rather than requiring one person to disappear", "at": 1066.9}, {"text": "into their expectations of another.", "at": 1069.44}], "highlight": {"text": "opportunities for growth", "at": 1065.42}, "tint": "sky"}},
{"id": "sec-09-17", "sectionId": "sec-09", "type": "bridgePlanks", "startSec": 1071.9, "endSec": 1082.2, "props": {"cliffsAt": 1071.9, "planks": [{"text": "Respectful consultation", "at": 997.74}, {"text": "Shared responsibilities", "at": 1007.88}, {"text": "Mutual support", "at": 1026.92}, {"text": "Honouring individuality", "at": 1049.98}], "caption": {"text": "work together", "at": 1078.98}, "railsAt": 1078.22}},
{"id": "sec-09-18", "sectionId": "sec-09", "type": "chapterRecap", "startSec": 1082.2, "endSec": 1086.4, "props": {"title": {"text": "Partnership, not competition", "at": 1082.3}, "signature": {"type": "bridgePlanks", "props": {"cliffsAt": 0, "planks": [{"text": "Respectful consultation", "at": 0}, {"text": "Shared responsibilities", "at": 0}, {"text": "Mutual support", "at": 0}, {"text": "Honouring individuality", "at": 0}], "railsAt": 0, "caption": {"text": "work together", "at": 0}}}, "cardAt": 1082.3, "words": [{"text": "Respected", "at": 1082.98}, {"text": "Supported", "at": 1083.98}, {"text": "Valued", "at": 1085.12}]}}
]}
