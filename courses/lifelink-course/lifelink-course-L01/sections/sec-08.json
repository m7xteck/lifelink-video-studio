{"type": "parallelPhrases", "id": "sec-08-08", "sectionId": "sec-08", "startSec": 873.2, "endSec": 882.6, "props": {"kicker": {"text": "Encouraged to choose a spouse primarily because of", "at": 875.42}, "items": [{"text": "Wealth", "at": 878.74}, {"text": "Professional standing", "at": 879.64}, {"text": "Family connections", "at": 880.94}]}},
{"type": "kineticStatement", "id": "sec-08-09", "sectionId": "sec-08", "startSec": 882.6, "endSec": 891.6, "props": {"kicker": {"text": "Practical circumstances are worth considering", "at": 883.34}, "lines": [{"text": "but should not overshadow", "at": 886.46}, {"text": "character, faith and compatibility", "at": 887.7}], "emphasis": ["character", "faith", "compatibility"], "align": "left", "scale": "h1"}},
{"type": "kineticStatement", "id": "sec-08-10", "sectionId": "sec-08", "startSec": 891.6, "endSec": 901.6, "props": {"kicker": {"text": "Household responsibilities", "at": 893.44}, "lines": [{"text": "Different cultures may have different expectations", "at": 895.82}, {"text": "about what husbands and wives should do within the home", "at": 898.76}], "emphasis": ["expectations"], "align": "left", "scale": "h2"}},
{"type": "takeaway", "id": "sec-08-11", "sectionId": "sec-08", "startSec": 901.6, "endSec": 912.6, "props": {"heading": "Within the home", "points": [{"text": "Understand Islamic rights and responsibilities", "at": 903.38}, {"text": "Discuss how you will organise your daily lives — fairly and respectfully", "at": 907.22}]}},
{"type": "kineticStatement", "id": "sec-08-12", "sectionId": "sec-08", "startSec": 912.6, "endSec": 922.7, "props": {"kicker": {"text": "The key message", "at": 913.2}, "lines": [{"text": "Cultural traditions should not justify", "at": 914.76}, {"text": "injustice,", "at": 918.02}, {"text": "humiliation", "at": 919.46}, {"text": "or coercion.", "at": 921.1}], "emphasis": ["injustice,", "humiliation", "coercion."], "align": "left", "scale": "h1"}},
{"type": "quietReflection", "id": "sec-08-13", "sectionId": "sec-08", "startSec": 922.7, "endSec": 926.8, "props": {"text": "When preparing for marriage, ask yourself these questions.", "at": 922.98}},
