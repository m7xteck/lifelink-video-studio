{"type": "kineticStatement", "id": "sec-08-05", "sectionId": "sec-08", "startSec": 840.6, "endSec": 853.2, "props": {"kicker": {"text": "In certain communities", "at": 841.0}, "lines": [{"text": "Pressure to organise an expensive wedding", "at": 842.88}, {"text": "to maintain their reputation", "at": 849.34}, {"text": "or demonstrate social standing", "at": 850.46}], "emphasis": ["expensive"], "align": "left", "scale": "h1"}},
