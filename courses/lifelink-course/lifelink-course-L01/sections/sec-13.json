      "props": {
        "variant": "offset",
        "lead": {
          "text": "Many people enter marriage with ideas about what married life should look like.",
          "at": 1523.8
        },
        "words": [
          {
            "text": "Upbringing",
            "at": 1530.52
          },
          {
            "text": "Cultural experiences",
