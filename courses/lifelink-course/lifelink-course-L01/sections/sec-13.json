          },
          {
            "text": "Family relationships",
            "at": 1532.64
          },
          {
            "text": "Films or social media",
            "at": 1533.84
          }
        ]
      }
    },
    {
      "id": "sec-13-03",
      "sectionId": "sec-13",
      "type": "highlightLine",
      "startSec": 1535.9,
      "endSec": 1545.0,
      "props": {
        "lines": [
          {
            "text": "Some expectations are healthy and reasonable:",
            "at": 1536.18
          },
          {
            "text": "respect, honesty, safety and kindness.",
            "at": 1540.44
          }
        ],
        "highlight": {
          "text": "healthy and reasonable",
          "at": 1537.46
        },
        "tint": "sky"
      }
    },
    {
      "id": "sec-13-04",
      "sectionId": "sec-13",
      "type": "kineticStatement",
      "startSec": 1545.0,
      "endSec": 1553.5,
      "props": {
        "lines": [
          {
            "text": "However, other expectations",
            "at": 1545.26
          },
          {
            "text": "can place unnecessary pressure",
            "at": 1546.7
          },
          {
            "text": "on a relationship.",
            "at": 1548.46
          },
          {
            "text": "Let us examine some of the myths.",
            "at": 1550.34
          }
        ],
        "emphasis": [
          "unnecessary",
          "pressure",
          "myths"
        ],
        "align": "left",
        "scale": "h2",
        "reveal": "focus"
      }
    },
    {
      "id": "sec-13-05",
      "sectionId": "sec-13",
      "type": "mythTruth",
      "startSec": 1553.5,
      "endSec": 1574.2,
      "props": {
        "myth": {
          "text": "A spouse will always make you happy.",
          "at": 1554.14
        },
        "tearAt": 1561.56,
        "truth": {
          "text": "Our spouse cannot be responsible for every aspect of our emotional wellbeing.",
          "at": 1562.1
        },
        "index": {
          "text": "first",
          "at": 1553.86
        },
        "notes": [
          {
            "text": "Personal growth",
            "at": 1570.12
          },
          {
            "text": "Interests",
            "at": 1571.58
          },
          {
            "text": "Sources of support",
            "at": 1572.34
          }
        ],
        "short": "Always happy"
      }
    },
    {
      "id": "sec-13-06",
      "sectionId": "sec-13",
      "type": "mythTruth",
      "startSec": 1574.2,
      "endSec": 1586.0,
      "props": {
        "myth": {
          "text": "Successful couples never disagree.",
          "at": 1575.32
        },
        "tearAt": 1579.22,
        "truth": {
          "text": "Two individuals will naturally have different opinions and preferences.",
          "at": 1581.44,
          "label": "unrealistic"
        },
        "index": {
          "text": "second",
          "at": 1574.6
        },
        "past": [
          "Always happy"
        ],
        "short": "Never disagree"
      }
    },
    {
      "id": "sec-13-07",
      "sectionId": "sec-13",
      "type": "pullQuote",
      "startSec": 1586.0,
      "endSec": 1593.3,
      "props": {
        "lines": [
          {
            "text": "The important issue is not",
            "at": 1586.36
          },
          {
            "text": "whether disagreements occur,",
            "at": 1588.64
          },
          {
            "text": "but whether they are managed respectfully.",
            "at": 1590.3
          }
        ],
        "emphasis": [
          "respectfully"
        ]
      }
    },
    {
      "id": "sec-13-08",
      "sectionId": "sec-13",
      "type": "mythTruth",
      "startSec": 1593.3,
      "endSec": 1610.5,
      "props": {
        "myth": {
          "text": "Our spouse should automatically know what we need.",
          "at": 1594.24
        },
        "tearAt": 1604.56,
